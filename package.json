{
  "name": "v3.yannislam.org",
  "version": "3.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-resume-manifest.js",
    "start": "ng serve",
    "prebuild": "node scripts/generate-resume-manifest.js",
    "build": "ng build",
    "postbuild": "node scripts/inject-env.js",
    "prewatch": "node scripts/generate-resume-manifest.js",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/generate-resume-manifest.js",
    "test": "ng test",
    "serve:ssr:v3.yannislam.org": "node dist/v3.yannislam.org/server/server.mjs",
    "pretest:e2e": "node scripts/generate-resume-manifest.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:perf": "lhci autorun --config=./lighthouserc.js",
    "test:perf:desktop": "LH_PRESET=desktop lhci autorun --config=./lighthouserc.js"
  },
  "private": true,
  "dependencies": {
