    "@angular/platform-server": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/service-worker": "22.1.1",
    "@angular/ssr": "^22.1.3",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "animejs": "^4.5.0",
    "bootstrap": "^5.3.8",
