    "ngx-typed-js": "^2.1.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "~22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/localize": "^22.1.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
