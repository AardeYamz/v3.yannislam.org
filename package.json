{
  "name": "v3.yannislam.org",
  "version": "3.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-resume-manifest.js && node scripts/fetch-theme.js",
    "start": "ng serve",
    "prebuild": "node scripts/generate-resume-manifest.js && node scripts/fetch-theme.js",
    "build": "ng build",
    "postbuild": "node scripts/inject-env.js",
    "prewatch": "node scripts/generate-resume-manifest.js && node scripts/fetch-theme.js",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/generate-resume-manifest.js && node scripts/fetch-theme.js",
    "test": "ng test",
    "test:scripts": "node --test scripts/*.test.js",
    "serve:ssr:v3.yannislam.org": "node dist/v3.yannislam.org/server/server.mjs",
    "pretest:e2e": "node scripts/generate-resume-manifest.js && node scripts/fetch-theme.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:perf": "lhci autorun --config=./lighthouserc.js",
    "test:perf:desktop": "LH_PRESET=desktop lhci autorun --config=./lighthouserc.js"
  },
  "private": true,
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "22.2.3",
    "@angular/ssr": "^22.2.3",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "animejs": "^4.5.0",
    "bootstrap": "^5.3.8",
    "express": "^5.3.0",
    "ngx-owl-carousel-o": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "~22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "http-server": "^14.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "lighthouse": "^13.4.1",
    "puppeteer-core": "^25.16.0",
    "@puppeteer/browsers": "^3.2.0",
    "@lhci/utils": {
      "js-yaml": "^4.1.1"
    },
    "vite": "^8.3.5",
    "chrome-launcher": "^1.2.2"
  }
}
